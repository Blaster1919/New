//Array of objects & array within class
#include<iostream.h>
#include<conio.h>
class result
{
     int rno;
     char nm[20];
     int m[3];
     int toatl;
     public:
	   void get();
	   void put();
};
void result :: get()
{
   cout<<"Enter Roll no,Name & mark of 3 Sub:";
   cin>>rno>>nm;
   total=0;
   for(int i=0;i<3;i++)
   {
     cin>>m[i];
     total+=m[i];
   }
}
void result :: put()
{
   cout<<endl<<rno<<"\t"<<nm;
   for(int i=0;i<3;i++)
   {
     cout<<"\t"<<m[i];
   }
   cout<<"\t"<<total;
}
void main()
{
   result r[5];
   clrscr();
   for(int i=0;i<5;i++)
   {   r[i].get();  }
   cout<<"\n Rno\t Name\t M1\tM2\tM3\tTotal";
   for(i=0;i<5;i++)
   {
      r[i].put();
   }
   getch();
}

