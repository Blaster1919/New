#include<conio.h>
#include<iostream.h>
void swap(int,int);
void swap1(int *,int *);
void main()
{
     int a,b;
     clrscr();
     cout<<"Enter two numbers";
     cin>>a>>b;
     cout<<"\nBefore swap() a="<<a<<"\tb="<<b;
     swap(a,b);
     cout<<"\nAfter swap() a="<<a<<"\tb="<<b;
     cout<<"\nBefore swap1() a="<<a<<"\tb="<<b;
     swap1(&a,&b);
     cout<<"\nAfter swap1() a="<<a<<"\tb="<<b;
     getch();
}
void swap(int a,int b)
{
  int c=a;
  a=b;
  b=c;
  cout<<"\nInside swap() a="<<a<<"\tb="<<b;
}
void swap1(int *a,int *b)
{
   int c=*a;
   *a=*b;
   *b=c;
   cout<<"\nInside swap1() a="<<*a<<"\tb="<<*b;
}
