#include<conio.h>
#include<iostream.h>
class demo
{
    private:
	    int a,b;
    public:
	  void input()
	  {
	     cout<<"Enter a and b:";
	     cin>>a>>b;
	  }
	  void output();
};
void demo :: output()
{
    cout<<"\n A="<<a;
    cout<<"\n B="<<b;
}
