#include<conio.h>
#include<iostream.h>
int pow(int x,int y=2);
void main()
{
   int x,y,z;
   clrscr();
   cout<<"Enter number:";
   cin>>x;
   cout<<"Enter power:";
   cin>>y;
   z=pow(x);
   cout<<"\nSum with default:"<<z;
   z=pow(x,y);
   cout<<"\nSum without default:"<<z;
   getch();
}
int pow(int x,int y)
{
   int ans=1;
   for(int i=1;i<=y;i++)
   {
     ans *=x;
   }
   return ans;
}