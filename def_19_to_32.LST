SQL> DECLARE
  2      n NUMBER := &n;
  3      fact NUMBER := 1;
  4      i NUMBER := 1;
  5  BEGIN
  6      IF n < 0 THEN
  7          DBMS_OUTPUT.PUT_LINE('Factorial is not defined for negative numbers.');
  8      ELSE
  9          WHILE i <= n LOOP
 10              fact := fact * i;
 11              i := i + 1;
 12          END LOOP;
 13  
 14          DBMS_OUTPUT.PUT_LINE('Factorial of ' || n || ' = ' || fact);
 15      END IF;
 16  END;
