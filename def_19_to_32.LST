SQL> ============ 32 ==========

SQL> SET SERVEROUTPUT ON;
SQL> 
SQL> DECLARE
  2      i NUMBER;
  3      j NUMBER;
  4      flag NUMBER;
  5  BEGIN
  6      FOR i IN 2..50 LOOP
  7          flag := 1;
  8  
  9          FOR j IN 2..TRUNC(SQRT(i)) LOOP
 10              IF MOD(i, j) = 0 THEN
 11                  flag := 0;
 12                  EXIT;
 13              END IF;
 14          END LOOP;
 15  
 16          IF flag = 1 THEN
 17              DBMS_OUTPUT.PUT_LINE(i);
 18          END IF;
 19      END LOOP;
 20  END;
