SQL> DECLARE
  2      rollno      NUMBER := &rollno;
  3      name        VARCHAR2(50) := '&name';
  4      mark1       NUMBER := &mark1;
  5      mark2       NUMBER := &mark2;
  6      mark3       NUMBER := &mark3;
  7      total       NUMBER;
  8      percentage  NUMBER;
  9      class_name  VARCHAR2(30);
 10  BEGIN
 11      total := mark1 + mark2 + mark3;
 12      percentage := total / 3;
 13  
 14      IF percentage >= 70 THEN
 15          class_name := 'Distinction';
 16      ELSIF percentage >= 60 THEN
 17          class_name := 'First Class';
 18      ELSIF percentage >= 50 THEN
 19          class_name := 'Second Class';
 20      ELSIF percentage >= 35 THEN
 21          class_name := 'Pass Class';
 22      ELSE
 23          class_name := 'Fail';
 24      END IF;
 25  
 26      DBMS_OUTPUT.PUT_LINE('Roll No     : ' || rollno);
 27      DBMS_OUTPUT.PUT_LINE('Name        : ' || name);
 28      DBMS_OUTPUT.PUT_LINE('Total       : ' || total);
 29      DBMS_OUTPUT.PUT_LINE('Percentage  : ' || percentage || '%');
 30      DBMS_OUTPUT.PUT_LINE('Class       : ' || class_name);
 31  END;
