  void get();
  public:
       void put()
       {
	   get();
	cout<<"\n a="<<a;
	cout<<"\n b="<<b;
	cout<<"\n c="<<c;
}
void demo :: get()
{
   cout<<"\nEnter an int,a float and a char:";
   cin>>a>>b>>c;
}
